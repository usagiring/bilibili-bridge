    "@node-rs/jieba": "^2.0.1",
    "@tokine/asr": "workspace:*",
    "@tokine/bilibili-recorder": "0.1.0",
    "@tokine/mt": "workspace:*",
    "ajv": "^8.20.0",
    "axios": "^1.16.1",
    "brotli": "^1.3.3",
    "dayjs": "^1.11.20",
    "drizzle-orm": "1.0.0-beta.22",
    "iconv-lite": "^0.7.2",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.0",
