{
  "name": "@tokine/bilibili-bridge",
  "version": "0.2.21",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:asr && npm run build:mt && npm run build:self",
    "build:self": "rm -rf dist && tsc && npm run copyproto",
    "copyproto": "cp ./lib/service/protobuf/*.proto ./dist/lib/service/protobuf",
    "start": "node ./dist/index",
    "start:test": "node ./bin/run-test.js",
    "dev": "nodemon --watch 'lib/**' --ext 'ts,json' --exec 'tsx index.ts test'",
    "dev:win": "nodemon --watch \"lib/**\" --ext \"ts,json\" --exec \"tsx index.ts test\"",
    "test": "mocha",
    "lint": "eslint lib/**/*",
    "release": "npm run build && npm publish",
    "build:asr": "cd packages/asr && npm run build",
    "build:mt": "cd packages/mt && npm run build"
  },
  "author": "其妙",
  "license": "MIT",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.5.0",
    "@koa/send": "^6.0.0",
    "@node-rs/jieba": "^2.0.1",
    "@tokine/asr": "workspace:*",
    "@tokine/bilibili-recorder": "0.1.0",
    "@tokine/mt": "workspace:*",
    "ajv": "^8.20.0",
    "axios": "^1.16.1",
    "brotli": "^1.3.3",
    "cookie": "^1.1.1",
    "drizzle-orm": "1.0.0-beta.22",
    "iconv-lite": "^0.7.2",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.0",
    "koa-bodyparser": "^4.4.1",
    "koa-logger": "^4.0.0",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "protobufjs": "^8.3.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/koa": "^3.0.2",
    "@types/nedb": "^1.8.16",
    "@types/node": "^25.8.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "drizzle-kit": "1.0.0-beta.22",
    "eslint": "^10.4.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}