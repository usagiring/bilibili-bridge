{
  "name": "@tokine/bilibili-bridge",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @tokine/bilibili-recorder run build && tsc && cp ./lib/service/protobuf/*.proto ./dist/lib/service/protobuf",
    "db:push": "drizzle-kit push",
    "start": "pnpm db:push && node ./dist/app",
    "start:test": "node ./bin/run-test.js",
    "dev": "pnpm db:push && tsx watch app.ts",
    "dev:win": "tsx watch app.ts",
    "test": "mocha",
    "lint": "eslint \"lib/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "format": "eslint --fix \"lib/**/*.ts\" \"packages/*/src/**/*.ts\"",
    "release": "pnpm build && pnpm -r publish"
  },
  "author": "其妙",
  "license": "MIT",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.5.0",
    "@koa/send": "^6.0.0",
    "@node-rs/jieba": "^2.0.1",
    "@tokine/bilibili-recorder": "workspace:*",
    "ajv": "^8.20.0",
    "axios": "^1.16.1",
    "brotli": "^1.3.3",
    "dayjs": "^1.11.20",
    "drizzle-orm": "1.0.0-beta.22",
    "iconv-lite": "^0.7.2",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.0",
    "koa-bodyparser": "^4.4.1",
    "koa-logger": "^4.0.0",
    "lodash": "^4.18.1",
    "protobufjs": "^8.3.0",
    "sherpa-onnx-node": "^1.13.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/koa": "^3.0.2",
    "@types/node": "^25.8.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "drizzle-kit": "1.0.0-beta.22",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@node-rs/jieba",
      "brotli"
    ]
  }
}